# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://scanflow:scanflow@localhost:5432/scanflow?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
CORS_ORIGINS=http://localhost:3001,http://localhost:8080
PUBLIC_API_URL=http://localhost:3000
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60

# Cloudflare R2 (S3-compatible). Leave blank to boot without object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# OAuth. Missing values make the matching /auth/* route return 503.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# RevenueCat. Missing values make /subscribe and the webhook return 503.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# SMTP. Password reset still stores a token when this is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@scanflow.app

# Seed a single demo user only when this is true.
SEED_DEMO=false
SEED_DEMO_PASSWORD=scanflow-demo-password

# Set to 1 to run API supertest e2e against DATABASE_URL.
SCANFLOW_E2E=0

# Admin
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mobile (copy into apps/mobile/.env)
SCANFLOW_API_URL=http://10.0.2.2:3000
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
REVENUECAT_API_KEY=
